[
  { "id": "voz_lider_01", "texto": "¡Apuntad a la cabeza! ¡Que cada bala cuente!", "tono": "gritando", "tipo": "orden" },
  { "id": "voz_lider_02", "texto": "¡Mantened la línea! ¡Que no pasen!", "tono": "gritando", "tipo": "orden" },
  { "id": "voz_lider_03", "texto": "¡Recargando, cubridme!", "tono": "respirando con fuerza", "tipo": "recarga" },
  { "id": "voz_lider_04", "texto": "¡Abrid fuego! ¡Dadles con todo!", "tono": "gritando", "tipo": "ataque" },
  { "id": "voz_lider_05", "texto": "¡Retroceded a las barricadas! ¡Ahora!", "tono": "gritando", "tipo": "retirada" },
  { "id": "voz_lider_06", "texto": "¡Revisad la munición! ¡Ahorrad disparos!", "tono": "urgente", "tipo": "munición" },
  { "id": "voz_lider_07", "texto": "¡Están rompiendo las barricadas! ¡Cuidado a la espalda!", "tono": "pánico", "tipo": "alerta" },
  { "id": "voz_lider_08", "texto": "¡Vienen zeds por el camino del oeste!", "tono": "gritando", "tipo": "alerta" },
  { "id": "voz_lider_09", "texto": "¡Aguantad el tipo, ya casi amanece!", "tono": "animando", "tipo": "ánimo" },
  { "id": "voz_lider_10", "texto": "¡Hoy no, malditos bastardos!", "tono": "enfadado", "tipo": "desafío" },
  { "id": "voz_lider_11", "texto": "¡Hemos aguantado la noche, seguid empujando!", "tono": "entusiasmado", "tipo": "ánimo" },
  { "id": "voz_lider_12", "texto": "¡Farmingdale no caerá! ¡A luchar!", "tono": "gritando", "tipo": "ánimo" },
  { "id": "voz_lider_13", "texto": "¡Son demasiados, romped filas y retroceded!", "tono": "pánico", "tipo": "retirada" },
  { "id": "voz_lider_14", "texto": "¡Abandonad la posición, repliegue inmediato!", "tono": "gritando", "tipo": "retirada" },
  { "id": "voz_lider_15", "texto": "¡Sálvese quien pueda, corred al ayuntamiento!", "tono": "pánico", "tipo": "huida" },
  { "id": "voz_lider_16", "texto": "¡A la carga, despejad la calle!", "tono": "gritando", "tipo": "ataque" },
  { "id": "voz_lider_17", "texto": "¡Avanzad sin miedo, devolvedlos a sus tumbas!", "tono": "gritando", "tipo": "ataque" },
  { "id": "voz_lider_18", "texto": "¡Fuego a discreción, hacedlos picadillo!", "tono": "gritando", "tipo": "ataque" },
  { "id": "voz_lider_19", "texto": "¡Agh! ¡Me han dado! ¡Cubridme, estoy perdiendo sangre!", "tono": "dolor", "tipo": "herido" },
  { "id": "voz_lider_20", "texto": "¡Maldita sea, me han alcanzado! ¡Pero aún sigo en pie!", "tono": "gruñendo", "tipo": "herido" },
  { "id": "voz_lider_21", "texto": "¡Ugh! ¡Es solo un rasguño, no dejéis de disparar!", "tono": "esforzándose", "tipo": "herido" }
]
